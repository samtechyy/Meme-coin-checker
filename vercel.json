{
  "version": 2,
  "builds": [
    { "src": "api/run.py", "use": "@vercel/python" },
    { "src": "api/data.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/run", "dest": "api/run.py" },
    { "src": "/api/data", "dest": "api/data.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "crons": [
    {
      "path": "/api/run",
      "schedule": "10 0 * * *"
    }
  ]
}